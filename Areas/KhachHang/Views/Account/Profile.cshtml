@model QLSanBong.Areas.KhachHang.Models.UserProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân sinh viên - UTC STADIUM";

    var fullName = Model.HoTen ?? "Sinh viên";
    var nameParts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initial = nameParts.Length > 0 ? nameParts[^1][0].ToString().ToUpper() : "U";
}

<div class="container-fluid px-3 px-lg-5">
    <!-- Breadcrumb điều hướng nhanh -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-area="KhachHang" asp-controller="Home" asp-action="Index" class="text-decoration-none">Tổng quan</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Hồ sơ cá nhân</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0" style="color: #002B5B;">
                <i class="bi bi-person-badge-fill text-warning me-2"></i>Quản Lý Thông Tin Tài Khoản
            </h2>
        </div>
        <a asp-area="KhachHang" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 py-2 small fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Quay về đặt sân
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 px-4 py-3 d-flex align-items-center justify-content-between shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                <span class="fw-semibold">@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="btn-close btn-sm shadow-none" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 px-4 py-3 d-flex align-items-center justify-content-between shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                <span class="fw-semibold">@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" class="btn-close btn-sm shadow-none" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <div class="row g-4">
        <!-- ===========================================================
             CỘT TRÁI (4 PHẦN): THẺ TỔNG QUAN TÀI KHOẢN & AVATAR
        =========================================================== -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white h-100">
                <div class="position-relative d-inline-block mx-auto mb-3">
                    @if (!string.IsNullOrEmpty(Model.AnhDaiDienUrl))
                    {
                        <img src="@Model.AnhDaiDienUrl" alt="@Model.HoTen" id="avatarPreview"
                             class="rounded-circle shadow-sm"
                             style="width: 120px; height: 120px; object-fit: cover; border: 4px solid #FFC107;" />
                    }
                    else
                    {
                        <div id="avatarFallback" class="rounded-circle shadow-sm d-flex align-items-center justify-content-center fw-bold mx-auto"
                             style="width: 120px; height: 120px; background-color: #FFC107; color: #002B5B; font-size: 3rem; border: 4px solid #002B5B;">
                            @initial
                        </div>
                        <img src="" alt="Avatar preview" id="avatarPreview"
                             class="rounded-circle shadow-sm d-none"
                             style="width: 120px; height: 120px; object-fit: cover; border: 4px solid #FFC107;" />
                    }
                </div>

                <h4 class="fw-bold mb-1" style="color: #002B5B;">@Model.HoTen</h4>
                <div class="text-muted small mb-2">@Model.Email</div>

                <div class="d-flex justify-content-center gap-2 mb-3">
                    <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-semibold">
                        <i class="bi bi-mortarboard-fill me-1"></i>@(Model.TenQuyen ?? "Sinh viên UTC")
                    </span>
                    <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill fw-semibold border border-success-subtle">
                        <i class="bi bi-check-circle-fill me-1"></i>@(Model.TrangThai ?? "Hoạt động")
                    </span>
                </div>

                <hr class="my-3 text-muted opacity-25">

                <div class="text-start small text-muted mb-3">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Số điện thoại:</span>
                        <strong class="text-dark">@(string.IsNullOrEmpty(Model.SoDienThoai) ? "Chưa cập nhật" : Model.SoDienThoai)</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Ngày tham gia:</span>
                        <strong class="text-dark">@(Model.NgayTao.HasValue ? Model.NgayTao.Value.ToString("dd/MM/yyyy") : "Đang cập nhật")</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Cập nhật gần nhất:</span>
                        <strong class="text-dark">@(Model.NgayCapNhat.HasValue ? Model.NgayCapNhat.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa có")</strong>
                    </div>
                </div>

                <div class="p-3 rounded-3 mt-auto text-start" style="background-color: #F4F7FB; border: 1px dashed #cbd5e1;">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-lightning-charge-fill text-warning fs-5 mt-1"></i>
                        <p class="small text-muted mb-0" style="font-size: 0.78rem; line-height: 1.45;">
                            Thông tin này được hệ thống tự động điền (Auto-fill) vào mọi đơn giữ sân và biên lai thanh toán chi đoàn của bạn.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- ===========================================================
             CỘT PHẢI (8 PHẦN): FORM CHỈNH SỬA THÔNG TIN & TẢI ẢNH ĐẠI DIỆN
        =========================================================== -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="mb-4">
                    <span class="badge px-3 py-1 rounded-pill mb-2" style="background-color: rgba(0, 43, 91, 0.08); color: #002B5B; font-weight: 700; font-size: 0.75rem;">
                        ĐỒNG BỘ DỮ LIỆU TỰ ĐỘNG
                    </span>
                    <h3 class="fw-bold mb-1" style="color: #002B5B;">Cập Nhật Hồ Sơ Thành Viên</h3>
                    <p class="text-muted small mb-0">
                        Thay đổi họ tên, số điện thoại liên lạc hoặc tải lên ảnh đại diện mới để đại diện chi đoàn đặt sân nhanh chóng.
                    </p>
                </div>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger rounded-3 py-2 small mb-3">
                        <div asp-validation-summary="ModelOnly" class="mb-0"></div>
                    </div>
                }

                <form asp-area="KhachHang" asp-controller="Account" asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="AnhDaiDienUrl" />

                    <div class="row g-3 mb-3">
                        <!-- 1. Họ và tên -->
                        <div class="col-md-6">
                            <label asp-for="HoTen" class="form-label fw-bold small" style="color: #002B5B;">
                                Họ và tên sinh viên <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-person-fill text-muted"></i></span>
                                <input asp-for="HoTen" class="form-control border-start-0 ps-0" placeholder="Nhập họ và tên đầy đủ" />
                            </div>
                            <span asp-validation-for="HoTen" class="text-danger small fw-semibold"></span>
                        </div>

                        <!-- 2. Số điện thoại -->
                        <div class="col-md-6">
                            <label asp-for="SoDienThoai" class="form-label fw-bold small" style="color: #002B5B;">
                                Số điện thoại liên hệ <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-telephone-fill text-muted"></i></span>
                                <input asp-for="SoDienThoai" class="form-control border-start-0 ps-0" placeholder="Ví dụ: 0988686868" />
                            </div>
                            <span asp-validation-for="SoDienThoai" class="text-danger small fw-semibold"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- 3. Địa chỉ Email -->
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-bold small" style="color: #002B5B;">
                                Địa chỉ Email <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope-at-fill text-muted"></i></span>
                                <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="sinhvien@st.utc.edu.vn" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small fw-semibold"></span>
                        </div>

                        <!-- 4. Vai trò tài khoản -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">Phân loại tài khoản</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-shield-check text-muted"></i></span>
                                <input type="text" class="form-control bg-light border-start-0 ps-0 text-muted" value="@(Model.TenQuyen ?? "Khách hàng sinh viên")" readonly />
                            </div>
                        </div>
                    </div>

                    <!-- 5. Tải lên ảnh đại diện mới -->
                    <div class="mb-4">
                        <label asp-for="AvatarFile" class="form-label fw-bold small" style="color: #002B5B;">
                            Thay đổi ảnh đại diện (Tùy chọn)
                        </label>
                        <input asp-for="AvatarFile" type="file" id="avatarFileInput" class="form-control" accept="image/png, image/jpeg, image/jpg, image/webp" />
                        <div class="form-text small text-muted">
                            Hỗ trợ định dạng: JPG, PNG, WEBP. Dung lượng tối đa: 5MB. Ảnh sẽ được tự động đồng bộ lên thanh điều hướng.
                        </div>
                        <span asp-validation-for="AvatarFile" class="text-danger small fw-semibold"></span>
                    </div>

                    <!-- Nút bấm hành động -->
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-3 border-top">
                        <a asp-area="" asp-controller="Account" asp-action="ForgotPassword" class="text-decoration-none small fw-semibold" style="color: #002B5B;">
                            <i class="bi bi-key-fill text-warning me-1"></i> Đổi mật khẩu qua Gmail OTP
                        </a>

                        <button type="submit" class="btn btn-warning fw-bold text-dark rounded-pill px-4 py-2 shadow-sm d-inline-flex align-items-center gap-2">
                            <i class="bi bi-floppy2-fill"></i>
                            <span>Lưu Thay Đổi &amp; Đồng Bộ Dữ Liệu</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const avatarFileInput = document.getElementById("avatarFileInput");
            const avatarPreview = document.getElementById("avatarPreview");
            const avatarFallback = document.getElementById("avatarFallback");

            if (avatarFileInput) {
                avatarFileInput.addEventListener("change", function () {
                    const file = this.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            if (avatarPreview) {
                                avatarPreview.src = e.target.result;
                                avatarPreview.classList.remove("d-none");
                            }
                            if (avatarFallback) {
                                avatarFallback.classList.add("d-none");
                            }
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }
        });
    </script>
}

