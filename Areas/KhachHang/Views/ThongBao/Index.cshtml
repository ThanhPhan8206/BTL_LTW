@model List<QLSanBong.Areas.KhachHang.Models.NotificationItemViewModel>
@{
    ViewData["Title"] = "Trung Tâm Thông Báo - UTC STADIUM";
    var filter = ViewBag.CurrentFilter as string ?? "all";
    var unreadCount = (int)(ViewBag.TotalUnread ?? 0);
}

<div class="container-fluid px-3 px-lg-5 py-4">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-area="KhachHang" asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a></li>
                    <li class="breadcrumb-item active fw-semibold" aria-current="page" style="color: #002B5B;">Hộp thư thông báo</li>
                </ol>
            </nav>
            <h2 class="fw-extrabold mb-0 d-flex align-items-center gap-2" style="color: #002B5B;">
                <i class="bi bi-bell-fill text-warning"></i>
                <span>Thông Báo Của Bạn</span>
                @if (unreadCount > 0)
                {
                    <span class="badge rounded-pill bg-danger fs-6 px-3 py-1">@unreadCount chưa đọc</span>
                }
            </h2>
            <p class="text-muted small mb-0 mt-1">Cập nhật tức thời trạng thái duyệt đơn, đổi lịch và thông báo hệ thống qua Web &amp; Gmail.</p>
        </div>

        @if (unreadCount > 0)
        {
            <form asp-area="KhachHang" asp-controller="ThongBao" asp-action="DanhDauTatCaDaDoc" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary rounded-pill px-4 fw-semibold shadow-sm">
                    <i class="bi bi-check2-all me-1"></i> Đánh dấu tất cả đã đọc
                </button>
            </form>
        }
    </div>

    <!-- Bộ lọc tab thông báo -->
    <div class="card border-0 shadow-sm rounded-4 p-2 bg-white mb-4">
        <ul class="nav nav-pills gap-2 flex-wrap">
            <li class="nav-item">
                <a class="nav-link rounded-pill px-3 py-2 fw-semibold @(filter == "all" ? "active" : "text-secondary")"
                   style="@(filter == "all" ? "background-color: #002B5B; color: #fff;" : "")"
                   asp-area="KhachHang" asp-controller="ThongBao" asp-action="Index" asp-route-filter="all">
                    <i class="bi bi-collection me-1"></i> Tất cả (@Model.Count)
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link rounded-pill px-3 py-2 fw-semibold @(filter == "unread" ? "active" : "text-secondary")"
                   style="@(filter == "unread" ? "background-color: #002B5B; color: #fff;" : "")"
                   asp-area="KhachHang" asp-controller="ThongBao" asp-action="Index" asp-route-filter="unread">
                    <i class="bi bi-envelope-exclamation me-1"></i> Chưa đọc (@unreadCount)
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link rounded-pill px-3 py-2 fw-semibold @(filter == "datsan" ? "active" : "text-secondary")"
                   style="@(filter == "datsan" ? "background-color: #002B5B; color: #fff;" : "")"
                   asp-area="KhachHang" asp-controller="ThongBao" asp-action="Index" asp-route-filter="datsan">
                    <i class="bi bi-calendar2-check me-1"></i> Đơn đặt sân
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link rounded-pill px-3 py-2 fw-semibold @(filter == "doilich" ? "active" : "text-secondary")"
                   style="@(filter == "doilich" ? "background-color: #002B5B; color: #fff;" : "")"
                   asp-area="KhachHang" asp-controller="ThongBao" asp-action="Index" asp-route-filter="doilich">
                    <i class="bi bi-arrow-repeat me-1"></i> Đổi lịch
                </a>
            </li>
        </ul>
    </div>

    <!-- Danh sách thông báo -->
    @if (Model.Any())
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var item in Model)
            {
                <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 bg-white position-relative transition-all @(!item.DaDoc ? "border-start border-4 border-warning bg-light" : "")">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3">
                        <div class="d-flex gap-3 align-items-start">
                            <div class="rounded-circle p-3 d-flex align-items-center justify-content-center shadow-sm"
                                 style="width: 48px; height: 48px; min-width: 48px; background-color: #F4F7FB;">
                                <i class="bi @item.IconClass fs-4"></i>
                            </div>

                            <div>
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                    <span class="badge @item.BadgeClass rounded-pill px-2 py-1 small">
                                        @item.BadgeText
                                    </span>
                                    @if (!item.DaDoc)
                                    {
                                        <span class="badge bg-danger rounded-pill px-2 py-1 small">Mới</span>
                                    }
                                    <span class="text-muted small">
                                        <i class="bi bi-clock me-1"></i>@item.ThoiGianTuongDoi
                                    </span>
                                </div>

                                <h6 class="fw-bold mb-1 @(!item.DaDoc ? "text-dark" : "text-secondary")" style="font-size: 1.02rem;">
                                    @item.TieuDe
                                </h6>
                                <p class="text-muted mb-0 small line-height-relaxed" style="white-space: pre-line;">
                                    @item.NoiDung
                                </p>
                            </div>
                        </div>

                        <!-- Các nút tương tác -->
                        <div class="d-flex align-items-center gap-2 ms-auto ms-md-0 align-self-end align-self-md-start">
                            @if (!item.DaDoc)
                            {
                                <form asp-area="KhachHang" asp-controller="ThongBao" asp-action="DanhDauDaDoc" asp-route-id="@item.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Đánh dấu đã đọc">
                                        <i class="bi bi-check2"></i> Đã đọc
                                    </button>
                                </form>
                            }

                            @if (item.LoaiThongBao == "HoanThanh")
                            {
                                <a asp-area="KhachHang" asp-controller="DatSan" asp-action="LichSu" class="btn btn-sm btn-warning fw-bold text-dark rounded-pill px-3 shadow-sm">
                                    <i class="bi bi-star-fill me-1"></i> Đánh giá ngay
                                </a>
                            }
                            else if (item.LoaiThongBao == "DoiLich")
                            {
                                <a asp-area="KhachHang" asp-controller="YeuCauDoiLich" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    Xem yêu cầu
                                </a>
                            }
                            else
                            {
                                <a asp-area="KhachHang" asp-controller="DatSan" asp-action="LichSu" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    Xem đơn
                                </a>
                            }

                            <form asp-area="KhachHang" asp-controller="ThongBao" asp-action="Xoa" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa thông báo này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-link text-danger p-2" title="Xóa thông báo">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <div class="py-4">
                <i class="bi bi-bell-slash fs-1 text-muted opacity-50"></i>
                <h5 class="fw-bold mt-3 mb-2" style="color: #002B5B;">Chưa có thông báo nào</h5>
                <p class="text-muted small mb-0">Khi có cập nhật về đơn đặt sân, yêu cầu dời lịch hoặc thông báo mới từ hệ thống, chúng tôi sẽ thông báo ngay tại đây và qua Gmail của bạn.</p>
            </div>
        </div>
    }
</div>

