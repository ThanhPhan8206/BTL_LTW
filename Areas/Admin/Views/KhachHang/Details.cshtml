@model QLSanBong.Models.ViewModels.KhachHangAdminDetailViewModel
@{
    ViewData["Title"] = $"Hồ sơ khách hàng: {Model.HoTen} - UTC STADIUM";
    var isLocked = Model.TrangThai.Equals("Bị khóa", StringComparison.OrdinalIgnoreCase) ||
                  Model.TrangThai.Equals("Bi khoa", StringComparison.OrdinalIgnoreCase) ||
                  Model.TrangThai.Equals("Locked", StringComparison.OrdinalIgnoreCase);
}

<!-- Breadcrumb & Top Bar -->
<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Tổng quan</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="KhachHang" asp-action="Index" class="text-decoration-none">Quản lý Khách hàng</a></li>
                <li class="breadcrumb-item active" aria-current="page">Chi tiết #@Model.Id</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0 text-navy" style="color: #002B5B;">Hồ Sơ Khách Hàng: @Model.HoTen</h2>
    </div>

    <div class="d-flex align-items-center gap-2">
        <a asp-area="Admin" asp-controller="KhachHang" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>

        <!-- Nút Khóa / Mở Khóa Tài Khoản -->
        <button type="button" class="btn @(isLocked ? "btn-success" : "btn-danger") rounded-pill px-4 fw-semibold shadow-sm"
                data-bs-toggle="modal" data-bs-target="#modalLockDetail">
            <i class="bi @(isLocked ? "bi-unlock-fill" : "bi-lock-fill") me-1"></i>
            @(isLocked ? "Mở Khóa Tài Khoản" : "Khóa Tài Khoản")
        </button>
    </div>
</div>

<!-- Modal xác nhận Khóa / Mở Khóa trên trang Details -->
<div class="modal fade" id="modalLockDetail" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered text-start">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-area="Admin" asp-controller="KhachHang" asp-action="ToggleLock" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="/Admin/KhachHang/Details/@Model.Id" />

                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold @(isLocked ? "text-success" : "text-danger")">
                        <i class="bi @(isLocked ? "bi-unlock-fill" : "bi-lock-fill") me-2"></i>
                        @(isLocked ? "Xác nhận Mở Khóa Tài Khoản" : "Xác nhận Khóa Tài Khoản")
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>

                <div class="modal-body py-3">
                    @if (isLocked)
                    {
                        <p class="mb-0">
                            Bạn có chắc chắn muốn <strong>MỞ KHÓA</strong> cho khách hàng <strong>@Model.HoTen</strong>?
                            Khách hàng sẽ có thể đăng nhập hệ thống và tiếp tục đặt sân.
                        </p>
                    }
                    else
                    {
                        <div class="alert alert-danger small rounded-3 mb-2">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            Tài khoản sau khi khóa sẽ không thể đăng nhập hoặc thao tác trên cổng UTC STADIUM.
                        </div>
                        <p class="mb-0">
                            Bạn có chắc chắn muốn <strong>KHÓA</strong> tài khoản của khách hàng <strong>@Model.HoTen</strong>?
                        </p>
                    }
                </div>

                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-sm btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-sm @(isLocked ? "btn-success" : "btn-danger") rounded-pill px-4 fw-semibold">
                        <i class="bi @(isLocked ? "bi-check-lg" : "bi-lock") me-1"></i>
                        @(isLocked ? "Mở Khóa Ngay" : "Khóa Tài Khoản")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Cột trái: Thông tin cá nhân -->
    <div class="col-lg-4">
        <div class="admin-card h-100">
            <div class="text-center pb-3 border-bottom mb-3">
                <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center fw-bold border shadow-sm mb-3"
                     style="width: 80px; height: 80px; font-size: 2rem; color: #002B5B;">
                    @(string.IsNullOrEmpty(Model.HoTen) ? "KH" : Model.HoTen.Substring(0, 1).ToUpper())
                </div>
                <h5 class="fw-bold mb-1 text-dark">@Model.HoTen</h5>
                <div class="text-muted small mb-2">Mã khách hàng: #@Model.Id</div>

                @if (isLocked)
                {
                    <span class="admin-badge admin-badge-locked">
                        <i class="bi bi-lock-fill"></i> Tài khoản Bị khóa
                    </span>
                }
                else
                {
                    <span class="admin-badge admin-badge-active">
                        <i class="bi bi-check-circle-fill"></i> Đang hoạt động
                    </span>
                }
            </div>

            <div class="d-flex flex-column gap-3 small">
                <div>
                    <span class="text-muted d-block">Địa chỉ Email:</span>
                    <strong class="text-dark">@Model.Email</strong>
                </div>

                <div>
                    <span class="text-muted d-block">Số điện thoại liên hệ:</span>
                    <strong class="text-dark">@Model.SoDienThoai</strong>
                </div>

                <div>
                    <span class="text-muted d-block">Ngày tạo tài khoản:</span>
                    <span class="text-dark">@(Model.NgayTao.HasValue ? Model.NgayTao.Value.ToString("dd/MM/yyyy HH:mm") : "---")</span>
                </div>

                <div>
                    <span class="text-muted d-block">Cập nhật gần nhất:</span>
                    <span class="text-dark">@(Model.NgayCapNhat.HasValue ? Model.NgayCapNhat.Value.ToString("dd/MM/yyyy HH:mm") : "---")</span>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top">
                <div class="p-3 rounded-4" style="background-color: #F8FAFC; border: 1px solid #E2E8F0;">
                    <div class="d-flex align-items-center gap-2 text-primary fw-bold small mb-1">
                        <i class="bi bi-shield-lock"></i> Bảo mật dữ liệu
                    </div>
                    <p class="small text-muted mb-0" style="font-size: 0.78rem;">
                        Tuân thủ chuẩn bảo mật phân quyền: Mật khẩu người dùng được mã hóa một chiều an toàn và không bao giờ hiển thị trên phân hệ Quản trị.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Cột phải: 4 Thẻ Thống kê Chỉ số Cá nhân -->
    <div class="col-lg-8">
        <div class="row g-3 mb-4">
            <!-- Chỉ số 1: Tổng số đơn -->
            <div class="col-sm-6">
                <div class="admin-card p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-bold text-uppercase">Tổng số đơn đặt</span>
                        <div class="rounded-circle p-2" style="background-color: rgba(0, 43, 91, 0.08); color: #002B5B;">
                            <i class="bi bi-calendar2-check-fill fs-5"></i>
                        </div>
                    </div>
                    <div class="fs-3 fw-bold" style="color: #002B5B;">
                        @Model.TongDonDat <span class="fs-6 text-muted fw-normal">đơn</span>
                    </div>
                    <span class="small text-muted">Toàn bộ lịch sử đặt ca</span>
                </div>
            </div>

            <!-- Chỉ số 2: Đơn hoàn thành -->
            <div class="col-sm-6">
                <div class="admin-card p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-bold text-uppercase">Đơn hoàn thành</span>
                        <div class="rounded-circle p-2" style="background-color: rgba(16, 185, 129, 0.12); color: #047857;">
                            <i class="bi bi-patch-check-fill fs-5"></i>
                        </div>
                    </div>
                    <div class="fs-3 fw-bold text-success">
                        @Model.DonHoanThanh <span class="fs-6 text-muted fw-normal">trận</span>
                    </div>
                    <span class="small text-muted">Đã thi đấu xong</span>
                </div>
            </div>

            <!-- Chỉ số 3: Đơn đã hủy / Từ chối -->
            <div class="col-sm-6">
                <div class="admin-card p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-bold text-uppercase">Đơn đã hủy / Từ chối</span>
                        <div class="rounded-circle p-2" style="background-color: rgba(239, 68, 68, 0.12); color: #B91C1C;">
                            <i class="bi bi-x-octagon-fill fs-5"></i>
                        </div>
                    </div>
                    <div class="fs-3 fw-bold text-danger">
                        @Model.DonDaHuy <span class="fs-6 text-muted fw-normal">đơn</span>
                    </div>
                    <span class="small text-muted">Đã hủy hoặc bị từ chối</span>
                </div>
            </div>

            <!-- Chỉ số 4: Tổng chi tiêu -->
            <div class="col-sm-6">
                <div class="admin-card p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-bold text-uppercase">Tổng chi tiêu</span>
                        <div class="rounded-circle p-2" style="background-color: rgba(255, 193, 7, 0.2); color: #B45309;">
                            <i class="bi bi-cash-coin fs-5"></i>
                        </div>
                    </div>
                    <div class="fs-3 fw-bold text-warning-emphasis">
                        @Model.TongChiTieu.ToString("N0") <span class="fs-6 text-muted fw-normal">VNĐ</span>
                    </div>
                    <span class="small text-muted">Doanh thu đóng góp thực nhận</span>
                </div>
            </div>
        </div>

        <!-- Bảng Lịch Sử Đặt Sân Của Khách Hàng -->
        <div class="admin-card">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="fw-bold mb-0 text-navy">
                    <i class="bi bi-clock-history text-warning me-2"></i>Lịch Sử Đặt Sân Của Khách Hàng
                </h5>
                <span class="badge bg-light text-dark border px-3 py-1 fw-bold">
                    @Model.LichSuDatSan.Count bản ghi
                </span>
            </div>

            @if (!Model.LichSuDatSan.Any())
            {
                <div class="text-center py-4">
                    <i class="bi bi-inbox text-muted fs-2"></i>
                    <p class="text-muted small mb-0 mt-2">Khách hàng này chưa có đơn đặt sân nào trên hệ thống.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table admin-table align-middle">
                        <thead>
                            <tr>
                                <th>MÃ ĐƠN</th>
                                <th>SÂN BÓNG</th>
                                <th>CA THI ĐẤU</th>
                                <th>NGÀY ĐẶT</th>
                                <th>TỔNG TIỀN</th>
                                <th>ĐÃ TRẢ</th>
                                <th class="text-center">TRẠNG THÁI</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in Model.LichSuDatSan)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-bold text-primary">#@booking.Id</span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@booking.TenSan</div>
                                        <div class="small text-muted">@booking.LoaiSan</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border fw-bold">
                                            <i class="bi bi-clock me-1 text-primary"></i>@booking.KhungGioDisplay
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@booking.NgayDat.ToString("dd/MM/yyyy")</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-navy">@booking.TongTien.ToString("N0") đ</span>
                                    </td>
                                    <td>
                                        @if (booking.DaThanhToan > 0)
                                        {
                                            <span class="badge bg-success-subtle text-success fw-bold">
                                                @booking.DaThanhToan.ToString("N0") đ
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-muted">0 đ</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (booking.TrangThai == "Hoàn thành")
                                        {
                                            <span class="admin-badge admin-badge-active">
                                                <i class="bi bi-check-circle-fill"></i> Hoàn thành
                                            </span>
                                        }
                                        else if (booking.TrangThai == "Đã duyệt")
                                        {
                                            <span class="admin-badge admin-badge-info">
                                                <i class="bi bi-shield-check"></i> Đã duyệt
                                            </span>
                                        }
                                        else if (booking.TrangThai == "Chờ duyệt")
                                        {
                                            <span class="admin-badge admin-badge-warning">
                                                <i class="bi bi-hourglass-split"></i> Chờ duyệt
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="admin-badge admin-badge-locked">
                                                <i class="bi bi-x-circle-fill"></i> @booking.TrangThai
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

