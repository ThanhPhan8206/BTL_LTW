@model QLSanBong.Areas.Admin.Models.AdminDichVuListViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Dịch vụ đi kèm - UTC STADIUM Admin";
}

<!-- Page Header Banner -->
<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-navy text-white fw-bold rounded-pill px-3 py-1" style="background-color: #002B5B;">
                <i class="bi bi-cup-straw text-warning me-1"></i> MODULE 5
            </span>
            <span class="text-muted small">Tiện ích sân bãi &amp; Nước giải khát</span>
        </div>
        <h2 class="fw-bold mb-0 text-navy" style="color: #002B5B;">Quản Lý Dịch Vụ Đi Kèm</h2>
        <p class="text-muted small mb-0">Cung cấp nước uống, bóng tập, áo bib và tổ chức trọng tài cho các đội bóng giao hữu.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" style="background-color: #002B5B; border-color: #002B5B;"
                data-bs-toggle="modal" data-bs-target="#modalCreateDichVu">
            <i class="bi bi-plus-circle-fill me-1 text-warning"></i> Thêm Dịch Vụ Mới
        </button>
    </div>
</div>

<!-- 3 Thẻ Thống Kê Tổng Quan -->
<div class="row g-3 mb-4">
    <!-- Tổng dịch vụ -->
    <div class="col-sm-4">
        <div class="admin-card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-bold text-uppercase">Tổng danh mục dịch vụ</span>
                <div class="rounded-circle p-2" style="background-color: rgba(0, 43, 91, 0.08); color: #002B5B;">
                    <i class="bi bi-collection fs-4"></i>
                </div>
            </div>
            <div class="fs-3 fw-bold" style="color: #002B5B;">
                @Model.TongDichVu
            </div>
            <span class="small text-muted">Toàn bộ mặt hàng tiện ích</span>
        </div>
    </div>

    <!-- Đang kinh doanh -->
    <div class="col-sm-4">
        <div class="admin-card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-bold text-uppercase">Đang mở bán</span>
                <div class="rounded-circle p-2" style="background-color: rgba(16, 185, 129, 0.12); color: #047857;">
                    <i class="bi bi-check2-circle fs-4"></i>
                </div>
            </div>
            <div class="fs-3 fw-bold text-success">
                @Model.DangKinhDoanh
            </div>
            <span class="small text-muted">Hiển thị trong form đặt sân của khách</span>
        </div>
    </div>

    <!-- Ngừng bán -->
    <div class="col-sm-4">
        <div class="admin-card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-bold text-uppercase">Đã ngừng bán</span>
                <div class="rounded-circle p-2" style="background-color: rgba(239, 68, 68, 0.12); color: #B91C1C;">
                    <i class="bi bi-pause-circle fs-4"></i>
                </div>
            </div>
            <div class="fs-3 fw-bold text-danger">
                @Model.NgungBan
            </div>
            <span class="small text-muted">Lưu lịch sử, không hiển thị cho khách mới</span>
        </div>
    </div>
</div>

<!-- Alert Thông báo -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Bộ Lọc Tìm Kiếm -->
<div class="admin-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-9">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@Model.Search" class="form-control border-start-0 ps-0" placeholder="Tìm theo tên dịch vụ (nước suối, bóng đá, trọng tài...) hoặc đơn vị tính..." />
            </div>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary rounded-pill px-3 w-100" style="background-color: #002B5B; border-color: #002B5B;">
                <i class="bi bi-filter me-1"></i> Tìm Kiếm
            </button>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <a asp-action="Index" class="btn btn-light rounded-pill px-3 border" title="Xóa bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            }
        </div>
    </form>
</div>

<!-- Bảng Danh Sách Dịch Vụ -->
<div class="admin-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-uppercase fw-bold text-secondary">
                    <th style="width: 60px;" class="text-center">ID</th>
                    <th>Tên Dịch Vụ</th>
                    <th style="width: 130px;" class="text-center">Đơn Vị Tính</th>
                    <th style="width: 150px;" class="text-end">Đơn Giá</th>
                    <th style="width: 140px;" class="text-center">Số Lượt Đã Dùng</th>
                    <th style="width: 150px;" class="text-center">Trạng Thái</th>
                    <th style="width: 180px;" class="text-center">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items != null && Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        var cleanName = item.TenDichVu.Replace("[Ngừng bán] ", "").Trim();
                        <tr>
                            <td class="text-center font-monospace text-muted small">#@item.Id</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" 
                                         style="width: 36px; height: 36px; background-color: @(item.DaNgungBan ? "#f1f5f9" : "#e0f2fe"); color: @(item.DaNgungBan ? "#64748b" : "#0284c7");">
                                        <i class="bi bi-box-seam"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold @(item.DaNgungBan ? "text-muted text-decoration-line-through" : "text-dark")">
                                            @cleanName
                                        </div>
                                        @if (item.DaNgungBan)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary" style="font-size: 11px;">Tạm ngưng phục vụ</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border px-2 py-1">@item.DonViTinh</span>
                            </td>
                            <td class="text-end font-monospace fw-bold text-primary">
                                @item.GiaDichVu.ToString("N0") đ
                            </td>
                            <td class="text-center font-monospace">
                                <span class="badge rounded-pill bg-info-subtle text-info-emphasis px-2">@item.SoLuotSuDung</span>
                            </td>
                            <td class="text-center">
                                @if (item.DaNgungBan)
                                {
                                    <span class="badge bg-danger-subtle text-danger px-2 py-1">
                                        <i class="bi bi-x-circle me-1"></i> Ngừng bán
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success px-2 py-1">
                                        <i class="bi bi-check-circle me-1"></i> Đang bán
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-inline-flex gap-1">
                                    <!-- Nút Sửa -->
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-circle" 
                                            title="Chỉnh sửa thông tin"
                                            onclick="openEditModal(@item.Id, '@Html.Raw(cleanName.Replace("'", "\\'"))', '@item.DonViTinh', @item.GiaDichVu)">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <!-- Nút Đổi trạng thái Bán / Ngừng bán -->
                                    @if (item.DaNgungBan)
                                    {
                                        <form asp-action="KichHoat" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success rounded-circle" title="Kích hoạt bán lại" onclick="return confirm('Mở bán lại dịch vụ này?')">
                                                <i class="bi bi-play-circle"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="NgungBan" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning rounded-circle" title="Ngừng bán dịch vụ" onclick="return confirm('Tạm thời ngừng bán dịch vụ này?')">
                                                <i class="bi bi-pause-circle"></i>
                                            </button>
                                        </form>
                                    }

                                    <!-- Nút Xóa (Xóa mềm nếu đã dùng, xóa cứng nếu chưa) -->
                                    <form asp-action="Delete" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="Xóa dịch vụ" 
                                                onclick="return confirm('Bạn có chắc muốn xóa dịch vụ này? Nếu dịch vụ đã phát sinh đơn đặt, hệ thống sẽ tự động chuyển sang chế độ [Ngừng bán] để bảo toàn dữ liệu lịch sử.')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            Không tìm thấy dịch vụ nào phù hợp với tìm kiếm.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Thêm Dịch Vụ Mới -->
<div class="modal fade" id="modalCreateDichVu" tabindex="-1" aria-labelledby="modalCreateDichVuLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header text-white" style="background-color: #002B5B;">
                    <h5 class="modal-title fw-bold" id="modalCreateDichVuLabel">
                        <i class="bi bi-plus-circle me-1 text-warning"></i> Thêm Dịch Vụ Mới
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Tên dịch vụ <span class="text-danger">*</span></label>
                        <input type="text" name="tenDichVu" class="form-control" placeholder="Ví dụ: Nước khoáng Lavie 500ml, Áo pitch tập, Trọng tài..." required />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Đơn vị tính <span class="text-danger">*</span></label>
                            <input type="text" name="donViTinh" class="form-control" placeholder="Chai, Lon, Bộ, Quả, Trận..." required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Đơn giá (VNĐ) <span class="text-danger">*</span></label>
                            <input type="number" name="giaDichVu" class="form-control" placeholder="10000" min="0" step="1000" required />
                        </div>
                    </div>
                    <div class="alert alert-info py-2 small mb-0">
                        <i class="bi bi-info-circle me-1"></i> Dịch vụ sau khi tạo sẽ tự động xuất hiện trong form đặt sân để khách hàng tùy chọn đi kèm.
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold" style="background-color: #002B5B; border-color: #002B5B;">
                        <i class="bi bi-check2-circle me-1"></i> Lưu Dịch Vụ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Chỉnh Sửa Dịch Vụ -->
<div class="modal fade" id="modalEditDichVu" tabindex="-1" aria-labelledby="modalEditDichVuLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="edit_id" name="id" />
                <div class="modal-header text-white" style="background-color: #002B5B;">
                    <h5 class="modal-title fw-bold" id="modalEditDichVuLabel">
                        <i class="bi bi-pencil-square me-1 text-warning"></i> Cập Nhật Dịch Vụ
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Tên dịch vụ <span class="text-danger">*</span></label>
                        <input type="text" id="edit_tenDichVu" name="tenDichVu" class="form-control" required />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Đơn vị tính <span class="text-danger">*</span></label>
                            <input type="text" id="edit_donViTinh" name="donViTinh" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Đơn giá (VNĐ) <span class="text-danger">*</span></label>
                            <input type="number" id="edit_giaDichVu" name="giaDichVu" class="form-control" min="0" step="1000" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold" style="background-color: #002B5B; border-color: #002B5B;">
                        <i class="bi bi-save me-1"></i> Cập Nhật
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openEditModal(id, ten, donVi, gia) {
        document.getElementById('edit_id').value = id;
        document.getElementById('edit_tenDichVu').value = ten;
        document.getElementById('edit_donViTinh').value = donVi;
        document.getElementById('edit_giaDichVu').value = gia;
        var editModal = new bootstrap.Modal(document.getElementById('modalEditDichVu'));
        editModal.show();
    }
</script>

