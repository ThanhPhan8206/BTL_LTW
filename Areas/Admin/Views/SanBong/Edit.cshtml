@model QLSanBong.Areas.Admin.Models.AdminSanBongInputViewModel
@{
    ViewData["Title"] = $"Chỉnh sửa Sân: {Model.TenSan} - UTC STADIUM";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1 small">
                        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Tổng quan</a></li>
                        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="SanBong" asp-action="Index" class="text-decoration-none">Quản lý Sân</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Chỉnh Sửa #@Model.Id</li>
                    </ol>
                </nav>
                <h2 class="fw-bold mb-0 text-navy" style="color: #002B5B;">Cập Nhật Thông Tin Sân Bóng</h2>
            </div>
            <a asp-area="Admin" asp-controller="SanBong" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>

        <div class="admin-card">
            <form asp-area="Admin" asp-controller="SanBong" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="AnhSanHienTai" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                <div class="row g-3">
                    <!-- Ảnh hiện tại -->
                    <div class="col-12 text-center pb-3 border-bottom">
                        <div class="d-inline-block position-relative">
                            <img src="@(string.IsNullOrEmpty(Model.AnhSanHienTai) ? "/uploads/sanbong/san-5-so-1.jpg" : Model.AnhSanHienTai)"
                                 alt="@Model.TenSan" class="rounded-4 border shadow-sm" style="width: 220px; height: 130px; object-fit: cover;"
                                 onerror="this.onerror=null;this.src='/uploads/sanbong/san-5-so-1.jpg';" />
                            <span class="badge bg-dark position-absolute bottom-0 start-50 translate-middle-x mb-2 opacity-75">
                                Ảnh sân hiện tại
                            </span>
                        </div>
                    </div>

                    <!-- Tên sân -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Tên Sân Bóng <span class="text-danger">*</span></label>
                        <input asp-for="TenSan" class="form-control rounded-3" required />
                        <span asp-validation-for="TenSan" class="text-danger small"></span>
                    </div>

                    <!-- Loại sân -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Loại Sân <span class="text-danger">*</span></label>
                        <select asp-for="LoaiSan" class="form-select rounded-3">
                            <option value="Sân 5 người">Sân 5 người (Mini cỏ nhân tạo)</option>
                            <option value="Sân 7 người">Sân 7 người (Tiêu chuẩn thi đấu giải)</option>
                            <option value="Sân 11 người">Sân 11 người (Mặt sân chuẩn Quốc gia)</option>
                        </select>
                        <span asp-validation-for="LoaiSan" class="text-danger small"></span>
                    </div>

                    <!-- Trạng thái -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Trạng Thái Hoạt Động</label>
                        <select asp-for="TrangThai" class="form-select rounded-3">
                            <option value="Sẵn sàng">Sẵn sàng (Đón khách đặt)</option>
                            <option value="Bảo trì">Bảo trì (Tạm ngưng đón khách)</option>
                            <option value="Ngừng hoạt động">Ngừng hoạt động (Tạm ẩn khỏi web)</option>
                        </select>
                    </div>

                    <!-- Đổi ảnh mới -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Đổi Ảnh Khác (Nếu có)</label>
                        <input asp-for="AnhSanFile" type="file" class="form-control rounded-3" accept="image/*" />
                        <div class="form-text small">Để trống nếu muốn giữ nguyên ảnh hiện tại.</div>
                    </div>

                    <!-- Mô tả -->
                    <div class="col-12">
                        <label class="form-label fw-semibold small">Mô Tả &amp; Đặc Điểm</label>
                        <textarea asp-for="MoTa" rows="3" class="form-control rounded-3"></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-area="Admin" asp-controller="SanBong" asp-action="Index" class="btn btn-light rounded-pill px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-semibold" style="background-color: #002B5B; border-color: #002B5B;">
                        <i class="bi bi-save me-1 text-warning"></i> Cập Nhật Thay Đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

