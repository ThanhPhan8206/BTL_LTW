@model QLSanBong.Areas.Admin.Models.AdminThongBaoListViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Thông báo & Sự kiện - UTC STADIUM Admin";
}

<!-- Page Header Banner -->
<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-navy text-white fw-bold rounded-pill px-3 py-1" style="background-color: #002B5B;">
                <i class="bi bi-megaphone-fill text-warning me-1"></i> MODULE 11
            </span>
            <span class="text-muted small">Kênh truyền thông &amp; Bắn Gmail tự động</span>
        </div>
        <h2 class="fw-bold mb-0 text-navy" style="color: #002B5B;">Quản Lý Thông Báo &amp; Sự Kiện</h2>
        <p class="text-muted small mb-0">Phát hành thông báo giải đấu, lịch bảo trì hệ thống và chiến dịch khuyến mãi đa kênh (Web &amp; Gmail).</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" style="background-color: #002B5B; border-color: #002B5B;"
                data-bs-toggle="modal" data-bs-target="#modalCreateThongBao">
            <i class="bi bi-send-fill me-1 text-warning"></i> Tạo &amp; Bắn Thông Báo Mới
        </button>
    </div>
</div>

<!-- 4 Thẻ Thống Kê Theo Loại Thông Báo -->
<div class="row g-3 mb-4">
    <!-- Tổng thông báo -->
    <div class="col-sm-6 col-xl-3">
        <div class="admin-card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-bold text-uppercase">Tổng tin đã phát hành</span>
                <div class="rounded-circle p-2" style="background-color: rgba(0, 43, 91, 0.08); color: #002B5B;">
                    <i class="bi bi-inbox-fill fs-4"></i>
                </div>
            </div>
            <div class="fs-3 fw-bold" style="color: #002B5B;">
                @Model.TongThongBao
            </div>
            <span class="small text-muted">Toàn bộ thông điệp trong hệ thống</span>
        </div>
    </div>

    <!-- Sự kiện & Giải đấu -->
    <div class="col-sm-6 col-xl-3">
        <div class="admin-card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-bold text-uppercase">Sự kiện &amp; Giải đấu</span>
                <div class="rounded-circle p-2" style="background-color: rgba(59, 130, 246, 0.12); color: #1D4ED8;">
                    <i class="bi bi-trophy-fill fs-4"></i>
                </div>
            </div>
            <div class="fs-3 fw-bold text-primary">
                @Model.SoThongBaoSuKien
            </div>
            <span class="small text-muted">Tin tức hội thao sinh viên</span>
        </div>
    </div>

    <!-- Hệ thống & Bảo trì -->
    <div class="col-sm-6 col-xl-3">
        <div class="admin-card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-bold text-uppercase">Hệ thống &amp; Bảo trì</span>
                <div class="rounded-circle p-2" style="background-color: rgba(245, 158, 11, 0.12); color: #D97706;">
                    <i class="bi bi-tools fs-4"></i>
                </div>
            </div>
            <div class="fs-3 fw-bold text-warning">
                @Model.SoThongBaoHeThong
            </div>
            <span class="small text-muted">Cảnh báo bảo dưỡng sân cỏ</span>
        </div>
    </div>

    <!-- Ưu đãi & Khuyến mãi -->
    <div class="col-sm-6 col-xl-3">
        <div class="admin-card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-bold text-uppercase">Ưu đãi &amp; Voucher</span>
                <div class="rounded-circle p-2" style="background-color: rgba(16, 185, 129, 0.12); color: #047857;">
                    <i class="bi bi-gift-fill fs-4"></i>
                </div>
            </div>
            <div class="fs-3 fw-bold text-success">
                @Model.SoThongBaoKhuyenMai
            </div>
            <span class="small text-muted">Chiến dịch tặng mã giảm giá</span>
        </div>
    </div>
</div>

<!-- Alert Thông báo -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Bộ Lọc Tìm Kiếm -->
<div class="admin-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@Model.Search" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm theo tiêu đề, nội dung, tên hoặc SĐT khách..." />
            </div>
        </div>
        <div class="col-md-4">
            <select name="loaiThongBao" class="form-select">
                <option value="all" selected="@(string.IsNullOrEmpty(Model.LoaiThongBao) || Model.LoaiThongBao == "all")">-- Tất cả loại thông báo --</option>
                <option value="SuKien" selected="@(Model.LoaiThongBao == "SuKien")">Sự kiện &amp; Giải đấu</option>
                <option value="HeThong" selected="@(Model.LoaiThongBao == "HeThong")">Thông báo hệ thống</option>
                <option value="KhuyenMai" selected="@(Model.LoaiThongBao == "KhuyenMai")">Khuyến mãi &amp; Ưu đãi</option>
                <option value="DuyetDon" selected="@(Model.LoaiThongBao == "DuyetDon")">Duyệt &amp; Hủy đơn đặt</option>
                <option value="DoiLich" selected="@(Model.LoaiThongBao == "DoiLich")">Yêu cầu đổi lịch</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary rounded-pill px-3 w-100 fw-semibold" style="background-color: #002B5B; border-color: #002B5B;">
                <i class="bi bi-filter me-1"></i> Lọc
            </button>
            @if (!string.IsNullOrWhiteSpace(Model.Search) || (!string.IsNullOrWhiteSpace(Model.LoaiThongBao) && Model.LoaiThongBao != "all"))
            {
                <a asp-action="Index" class="btn btn-light rounded-pill px-3 border" title="Xóa bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            }
        </div>
    </form>
</div>

<!-- Bảng Danh Sách Thông Báo -->
<div class="admin-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-uppercase fw-bold text-secondary">
                    <th style="width: 60px;" class="text-center">ID</th>
                    <th style="width: 200px;">Người Nhận</th>
                    <th style="width: 140px;" class="text-center">Phân Loại</th>
                    <th>Tiêu Đề &amp; Nội Dung Thông Báo</th>
                    <th style="width: 110px;" class="text-center">Trạng Thái</th>
                    <th style="width: 140px;" class="text-center">Thời Gian Gửi</th>
                    <th style="width: 90px;" class="text-center">Xóa</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items != null && Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        var badgeColor = item.LoaiThongBao switch
                        {
                            "SuKien" => "bg-primary-subtle text-primary border-primary",
                            "HeThong" => "bg-warning-subtle text-dark border-warning",
                            "KhuyenMai" => "bg-success-subtle text-success border-success",
                            "DuyetDon" => "bg-info-subtle text-info-emphasis border-info",
                            "DoiLich" => "bg-secondary-subtle text-secondary border-secondary",
                            _ => "bg-light text-dark"
                        };

                        var badgeText = item.LoaiThongBao switch
                        {
                            "SuKien" => "Sự kiện",
                            "HeThong" => "Hệ thống",
                            "KhuyenMai" => "Ưu đãi",
                            "DuyetDon" => "Đơn đặt",
                            "DoiLich" => "Đổi lịch",
                            _ => item.LoaiThongBao
                        };

                        <tr>
                            <td class="text-center font-monospace text-muted small">#@item.Id</td>
                            <td>
                                <div class="fw-bold text-dark">@item.TenKhachHang</div>
                                <div class="small text-muted"><i class="bi bi-telephone me-1"></i> @(string.IsNullOrEmpty(item.SoDienThoai) ? "---" : item.SoDienThoai)</div>
                                <div class="small text-muted text-truncate" style="max-width: 180px;"><i class="bi bi-envelope me-1"></i> @item.Email</div>
                            </td>
                            <td class="text-center">
                                <span class="badge border px-2 py-1 @badgeColor" style="font-size: 11px;">
                                    @badgeText
                                </span>
                            </td>
                            <td>
                                <div class="fw-bold text-navy" style="color: #002B5B;">
                                    @item.TieuDe
                                </div>
                                <div class="small text-muted mt-1" style="white-space: pre-line; max-height: 80px; overflow-y: auto;">
                                    @item.NoiDung
                                </div>
                            </td>
                            <td class="text-center">
                                @if (item.DaDoc)
                                {
                                    <span class="badge bg-success-subtle text-success px-2 py-1" style="font-size: 11px;">
                                        <i class="bi bi-check2-all me-1"></i> Đã đọc
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary px-2 py-1" style="font-size: 11px;">
                                        <i class="bi bi-envelope me-1"></i> Chưa đọc
                                    </span>
                                }
                            </td>
                            <td class="text-center small text-muted">
                                @(item.NgayTao.HasValue ? item.NgayTao.Value.ToString("dd/MM/yyyy HH:mm") : "---")
                            </td>
                            <td class="text-center">
                                <form asp-action="Delete" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="Xóa thông báo" onclick="return confirm('Bạn có chắc muốn xóa bản ghi thông báo này?')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-bell-slash fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            Không có thông báo nào phù hợp với điều kiện tìm kiếm.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Phân Trang -->
    @if (Model.TotalPages > 1)
    {
        <div class="p-3 border-top d-flex align-items-center justify-content-between">
            <span class="small text-muted">Trang @Model.Page / @Model.TotalPages (Tổng @Model.TotalItems bản ghi)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-loaiThongBao="@Model.LoaiThongBao">Trước</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-loaiThongBao="@Model.LoaiThongBao">@p</a>
                    </li>
                }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-loaiThongBao="@Model.LoaiThongBao">Sau</a>
                </li>
            </ul>
        </div>
    }
</div>

<!-- Modal Tạo & Bắn Thông Báo Mới -->
<div class="modal fade" id="modalCreateThongBao" tabindex="-1" aria-labelledby="modalCreateThongBaoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header text-white" style="background-color: #002B5B;">
                    <h5 class="modal-title fw-bold" id="modalCreateThongBaoLabel">
                        <i class="bi bi-megaphone me-1 text-warning"></i> Soạn &amp; Phát Hành Thông Báo Mới
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold small">Tiêu đề thông báo <span class="text-danger">*</span></label>
                            <input type="text" name="tieuDe" class="form-control" placeholder="VD: [SỰ KIỆN] Khai mạc Giải Bóng Đá Sinh Viên UTC 2026..." required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Phân loại <span class="text-danger">*</span></label>
                            <select name="loaiThongBao" class="form-select" required>
                                <option value="SuKien" selected>Sự kiện &amp; Giải đấu</option>
                                <option value="HeThong">Hệ thống &amp; Bảo trì</option>
                                <option value="KhuyenMai">Khuyến mãi &amp; Ưu đãi</option>
                            </select>
                        </div>
                    </div>

                    <!-- Lựa chọn người nhận -->
                    <div class="mb-3 p-3 rounded-3" style="background-color: #f8fafc; border: 1px solid #eef2f6;">
                        <label class="form-label fw-semibold small d-block mb-2">Đối tượng người nhận:</label>
                        
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="checkGuiToanHeThong" name="guiTatCa" value="true" onchange="toggleSelectTarget(this)">
                            <label class="form-check-label fw-bold text-primary" for="checkGuiToanHeThong">
                                <i class="bi bi-people-fill me-1"></i> Bắn thông báo đến TOÀN BỘ khách hàng đang hoạt động (@Model.DanhSachKhachHang.Count khách)
                            </label>
                        </div>

                        <div id="wrapperTargetCustomer">
                            <label class="form-label small text-muted">Hoặc chọn 1 khách hàng cụ thể:</label>
                            <select name="nguoiDungId" id="selectTargetCustomer" class="form-select">
                                <option value="">-- Chọn khách hàng nhận thông báo --</option>
                                @foreach (var kh in Model.DanhSachKhachHang)
                                {
                                    <option value="@kh.Id">@kh.HoTen - SĐT: @kh.SoDienThoai (@kh.Email)</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Nội dung thông báo chi tiết <span class="text-danger">*</span></label>
                        <textarea name="noiDung" class="form-control" rows="5" placeholder="Nhập đầy đủ thông tin sự kiện, thời gian diễn ra, thể lệ tham gia hoặc chi tiết bảo dưỡng sân bãi..." required></textarea>
                    </div>

                    <div class="alert alert-info py-2 small mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-envelope-check-fill fs-5 text-primary"></i>
                        <div>Hệ thống sẽ tự động lưu thông báo vào hòm thư trên Web của khách và gửi kèm một Email HTML chuẩn Gmail qua dịch vụ SMTP.</div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold" style="background-color: #002B5B; border-color: #002B5B;">
                        <i class="bi bi-send-fill me-1"></i> Phát Hành &amp; Bắn Tin Ngay
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function toggleSelectTarget(checkbox) {
        var wrapper = document.getElementById('wrapperTargetCustomer');
        var select = document.getElementById('selectTargetCustomer');
        if (checkbox.checked) {
            wrapper.style.display = 'none';
            select.removeAttribute('required');
        } else {
            wrapper.style.display = 'block';
        }
    }
</script>

