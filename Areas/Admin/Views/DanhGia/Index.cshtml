@model QLSanBong.Areas.Admin.Models.AdminDanhGiaListViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Đánh giá của khách - UTC STADIUM Admin";
}

<!-- Page Header Banner -->
<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-navy text-white fw-bold rounded-pill px-3 py-1" style="background-color: #002B5B;">
                <i class="bi bi-star-fill text-warning me-1"></i> MODULE 10
            </span>
            <span class="text-muted small">Ý kiến người dùng &amp; Tiêu chuẩn dịch vụ</span>
        </div>
        <h2 class="fw-bold mb-0 text-navy" style="color: #002B5B;">Đánh Giá &amp; Phản Hồi Của Khách</h2>
        <p class="text-muted small mb-0">Lắng nghe nhận xét về chất lượng mặt cỏ, ánh sáng, dịch vụ và phản hồi trực tiếp tới khách hàng.</p>
    </div>
</div>

<!-- Thẻ Điểm Đánh Giá & Phân Bổ Sao -->
<div class="row g-3 mb-4">
    <!-- Điểm trung bình -->
    <div class="col-sm-6 col-xl-3">
        <div class="admin-card p-3 h-100 text-center d-flex flex-column justify-content-center">
            <span class="text-muted small fw-bold text-uppercase mb-1">Điểm đánh giá trung bình</span>
            <div class="display-4 fw-bold text-warning mb-1">
                @Model.DiemTrungBinh <span class="fs-4 text-muted fw-normal">/ 5.0</span>
            </div>
            <div>
                @for (int i = 1; i <= 5; i++)
                {
                    if (i <= Math.Round(Model.DiemTrungBinh))
                    {
                        <i class="bi bi-star-fill text-warning fs-5"></i>
                    }
                    else
                    {
                        <i class="bi bi-star text-muted fs-5"></i>
                    }
                }
            </div>
            <span class="small text-muted mt-2">Dựa trên <strong>@Model.TongDanhGia</strong> nhận xét</span>
        </div>
    </div>

    <!-- Phân bổ 5 sao và 4 sao -->
    <div class="col-sm-6 col-xl-3">
        <div class="admin-card p-3 h-100">
            <span class="text-muted small fw-bold text-uppercase d-block mb-2">Đánh giá xuất sắc &amp; Tốt</span>
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="small fw-semibold text-success"><i class="bi bi-star-fill text-warning me-1"></i> 5 Sao (Rất tốt):</span>
                <span class="badge bg-success-subtle text-success font-monospace fs-6">@Model.SoLuong5Sao</span>
            </div>
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="small fw-semibold text-primary"><i class="bi bi-star-fill text-warning me-1"></i> 4 Sao (Hài lòng):</span>
                <span class="badge bg-primary-subtle text-primary font-monospace fs-6">@Model.SoLuong4Sao</span>
            </div>
            <div class="d-flex align-items-center justify-content-between">
                <span class="small fw-semibold text-info"><i class="bi bi-star-fill text-warning me-1"></i> 3 Sao (Bình thường):</span>
                <span class="badge bg-info-subtle text-info font-monospace fs-6">@Model.SoLuong3Sao</span>
            </div>
        </div>
    </div>

    <!-- Phân bổ 1 sao & 2 sao -->
    <div class="col-sm-6 col-xl-3">
        <div class="admin-card p-3 h-100">
            <span class="text-muted small fw-bold text-uppercase d-block mb-2">Cần cải thiện chất lượng</span>
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="small fw-semibold text-warning"><i class="bi bi-star-fill text-warning me-1"></i> 2 Sao (Chưa hài lòng):</span>
                <span class="badge bg-warning-subtle text-dark font-monospace fs-6">@Model.SoLuong2Sao</span>
            </div>
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="small fw-semibold text-danger"><i class="bi bi-star-fill text-warning me-1"></i> 1 Sao (Kém):</span>
                <span class="badge bg-danger-subtle text-danger font-monospace fs-6">@Model.SoLuong1Sao</span>
            </div>
            <span class="small text-muted d-block mt-2">Cần ưu tiên liên hệ giải quyết khiếu nại</span>
        </div>
    </div>

    <!-- Số đánh giá bị ẩn -->
    <div class="col-sm-6 col-xl-3">
        <div class="admin-card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-bold text-uppercase">Đánh giá bị ẩn</span>
                <div class="rounded-circle p-2" style="background-color: rgba(239, 68, 68, 0.12); color: #B91C1C;">
                    <i class="bi bi-eye-slash-fill fs-4"></i>
                </div>
            </div>
            <div class="fs-3 fw-bold text-danger mb-1">
                @Model.SoLuongDaAn <span class="fs-6 fw-normal text-muted">lượt</span>
            </div>
            <span class="small text-muted">Nội dung không phù hợp đã bị ẩn khỏi Web khách hàng</span>
        </div>
    </div>
</div>

<!-- Alert Thông báo -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Bộ Lọc Tìm Kiếm -->
<div class="admin-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <select name="soSao" class="form-select">
                <option value="" selected="@(!Model.SoSao.HasValue)">-- Tất cả số sao đánh giá --</option>
                <option value="5" selected="@(Model.SoSao == 5)">★★★★★ (5 Sao)</option>
                <option value="4" selected="@(Model.SoSao == 4)">★★★★☆ (4 Sao)</option>
                <option value="3" selected="@(Model.SoSao == 3)">★★★☆☆ (3 Sao)</option>
                <option value="2" selected="@(Model.SoSao == 2)">★★☆☆☆ (2 Sao)</option>
                <option value="1" selected="@(Model.SoSao == 1)">★☆☆☆☆ (1 Sao)</option>
            </select>
        </div>
        <div class="col-md-5">
            <select name="sanBongId" class="form-select">
                <option value="" selected="@(!Model.SanBongId.HasValue)">-- Tất cả sân bóng --</option>
                @foreach (var s in Model.DanhSachSanBong)
                {
                    <option value="@s.Id" selected="@(Model.SanBongId == s.Id)">@s.TenSan (@s.LoaiSan)</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary rounded-pill px-3 w-100 fw-semibold" style="background-color: #002B5B; border-color: #002B5B;">
                <i class="bi bi-filter me-1"></i> Lọc
            </button>
            @if (Model.SoSao.HasValue || Model.SanBongId.HasValue)
            {
                <a asp-action="Index" class="btn btn-light rounded-pill px-3 border" title="Xóa bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            }
        </div>
    </form>
</div>

<!-- Danh Sách Đánh Giá -->
<div class="admin-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-uppercase fw-bold text-secondary">
                    <th style="width: 60px;" class="text-center">ID</th>
                    <th style="width: 200px;">Khách Hàng</th>
                    <th style="width: 160px;">Sân Thi Đấu</th>
                    <th style="width: 140px;">Đánh Giá</th>
                    <th>Nội Dung Nhận Xét &amp; Phản Hồi Của Admin</th>
                    <th style="width: 130px;" class="text-center">Thời Gian</th>
                    <th style="width: 140px;" class="text-center">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items != null && Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr class="@(item.DaAn ? "table-light opacity-75" : "")">
                            <td class="text-center font-monospace text-muted small">#@item.Id</td>
                            <td>
                                <div class="fw-bold text-dark">@item.TenKhachHang</div>
                                <div class="small text-muted"><i class="bi bi-telephone me-1"></i> @item.SoDienThoai</div>
                                <div class="small text-muted font-monospace"><i class="bi bi-receipt me-1"></i> Đơn #@item.DatSanId</div>
                            </td>
                            <td>
                                <span class="fw-semibold text-primary">@item.TenSan</span>
                                <div class="small text-muted">@item.LoaiSan</div>
                            </td>
                            <td>
                                <div class="text-warning fs-6">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= item.SoSao)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-muted"></i>
                                        }
                                    }
                                </div>
                                <span class="small fw-bold text-secondary">@item.SoSao / 5 sao</span>
                            </td>
                            <td>
                                <!-- Bình luận của khách -->
                                <div>
                                    @if (item.DaAn)
                                    {
                                        <span class="badge bg-danger-subtle text-danger me-1">
                                            <i class="bi bi-eye-slash-fill me-1"></i> [ĐÃ ẨN]
                                        </span>
                                    }
                                    <span class="text-dark">@(string.IsNullOrWhiteSpace(item.BinhLuanGoc) ? "(Không có lời bình)" : item.BinhLuanGoc)</span>
                                </div>

                                <!-- Hộp Phản Hồi của Admin nếu có -->
                                @if (!string.IsNullOrWhiteSpace(item.PhanHoiAdmin))
                                {
                                    <div class="mt-2 p-2 rounded-3 small" style="background-color: #f1f5f9; border-left: 3px solid #002B5B;">
                                        <div class="fw-bold text-navy mb-1" style="color: #002B5B;">
                                            <i class="bi bi-reply-fill me-1 text-primary"></i> Phản hồi từ BQL Sân:
                                        </div>
                                        <div class="text-secondary fst-italic">@item.PhanHoiAdmin</div>
                                    </div>
                                }
                            </td>
                            <td class="text-center small text-muted">
                                @(item.NgayTao.HasValue ? item.NgayTao.Value.ToString("dd/MM/yyyy HH:mm") : "---")
                            </td>
                            <td class="text-center">
                                <div class="d-inline-flex gap-1">
                                    <!-- Nút Phản hồi -->
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-circle" title="Phản hồi đánh giá này"
                                            onclick="openPhanHoiModal(@item.Id, '@Html.Raw(item.TenKhachHang.Replace("'", "\\'"))', '@Html.Raw((item.PhanHoiAdmin ?? "").Replace("'", "\\'"))')">
                                        <i class="bi bi-reply-fill"></i>
                                    </button>

                                    <!-- Nút Ẩn / Mở ẩn -->
                                    <form asp-action="AnDanhGia" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm @(item.DaAn ? "btn-outline-success" : "btn-outline-warning") rounded-circle" 
                                                title="@(item.DaAn ? "Mở hiển thị lại" : "Ẩn đánh giá khỏi Web")">
                                            <i class="bi @(item.DaAn ? "bi-eye-fill" : "bi-eye-slash-fill")"></i>
                                        </button>
                                    </form>

                                    <!-- Nút Xóa vĩnh viễn -->
                                    <form asp-action="Delete" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="Xóa đánh giá" onclick="return confirm('Bạn có chắc muốn xóa đánh giá này?')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-chat-square-dots fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            Chưa có đánh giá nào phù hợp với điều kiện tìm kiếm.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Phân Trang -->
    @if (Model.TotalPages > 1)
    {
        <div class="p-3 border-top d-flex align-items-center justify-content-between">
            <span class="small text-muted">Trang @Model.Page / @Model.TotalPages (Tổng @Model.TotalItems đánh giá)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-soSao="@Model.SoSao" asp-route-sanBongId="@Model.SanBongId">Trước</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-soSao="@Model.SoSao" asp-route-sanBongId="@Model.SanBongId">@p</a>
                    </li>
                }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-soSao="@Model.SoSao" asp-route-sanBongId="@Model.SanBongId">Sau</a>
                </li>
            </ul>
        </div>
    }
</div>

<!-- Modal Phản Hồi Đánh Giá -->
<div class="modal fade" id="modalPhanHoi" tabindex="-1" aria-labelledby="modalPhanHoiLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="PhanHoi" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="phanhoi_id" name="id" />
                <div class="modal-header text-white" style="background-color: #002B5B;">
                    <h5 class="modal-title fw-bold" id="modalPhanHoiLabel">
                        <i class="bi bi-reply-fill me-1 text-warning"></i> Phản Hồi Nhận Xét Khách Hàng
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small text-muted">Khách hàng nhận xét:</label>
                        <div class="fw-bold fs-6 text-dark" id="phanhoi_tenKhach"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Nội dung phản hồi từ BQL <span class="text-danger">*</span></label>
                        <textarea id="phanhoi_noiDung" name="noiDungPhanHoi" class="form-control" rows="4" placeholder="Nhập lời cảm ơn hoặc giải trình gửi tới khách hàng..." required></textarea>
                    </div>
                    <div class="alert alert-info py-2 small mb-0">
                        <i class="bi bi-bell-fill me-1"></i> Sau khi lưu, hệ thống sẽ tự động cập nhật phản hồi hiển thị công khai và bắn 1 thông báo vào tài khoản khách hàng.
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold" style="background-color: #002B5B; border-color: #002B5B;">
                        <i class="bi bi-send-fill me-1"></i> Gửi Phản Hồi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openPhanHoiModal(id, tenKhach, noiDungCu) {
        document.getElementById('phanhoi_id').value = id;
        document.getElementById('phanhoi_tenKhach').innerText = tenKhach;
        document.getElementById('phanhoi_noiDung').value = noiDungCu;
        var modal = new bootstrap.Modal(document.getElementById('modalPhanHoi'));
        modal.show();
    }
</script>

