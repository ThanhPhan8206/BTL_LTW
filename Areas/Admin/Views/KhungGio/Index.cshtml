@model QLSanBong.Areas.Admin.Models.AdminKhungGioViewModel
@{
    ViewData["Title"] = "Quản lý Khung giờ Ca thi đấu - UTC STADIUM";
}

<!-- Page Header Banner & Tabs -->
<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-navy text-white fw-bold rounded-pill px-3 py-1" style="background-color: #002B5B;">
                <i class="bi bi-clock-history me-1 text-warning"></i> MODULE 4
            </span>
            <span class="text-muted small">Cấu hình thời gian &amp; Ca thi đấu</span>
        </div>
        <h2 class="fw-bold mb-0 text-navy" style="color: #002B5B;">Quản Lý Khung Giờ Thi Đấu</h2>
        <p class="text-muted small mb-0">Cấu hình các ca đá trong ngày, đảm bảo không có khoảng thời gian bị chồng chéo.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-area="Admin" asp-controller="ThietLapGia" asp-action="Index" class="btn btn-outline-primary rounded-pill px-3 fw-semibold">
            <i class="bi bi-grid-3x3 me-1"></i> Ma Trận Giá Thuê
        </a>
        <button type="button" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" style="background-color: #002B5B; border-color: #002B5B;"
                data-bs-toggle="modal" data-bs-target="#modalCreateSlot">
            <i class="bi bi-plus-lg me-1 text-warning"></i> Thêm Khung Giờ Mới
        </button>
    </div>
</div>

<!-- Tabs Điều Hướng Khung Giờ & Ma Trận Giá -->
<ul class="nav nav-pills mb-4 gap-2">
    <li class="nav-item">
        <a class="nav-link active rounded-pill fw-semibold px-4" style="background-color: #002B5B;" href="javascript:void(0);">
            <i class="bi bi-clock me-1 text-warning"></i> 1. Danh sách Khung giờ (@Model.TotalSlots ca)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link bg-white text-dark border rounded-pill fw-semibold px-4" asp-area="Admin" asp-controller="ThietLapGia" asp-action="Index">
            <i class="bi bi-cash-stack me-1 text-success"></i> 2. Thiết lập Ma trận Giá
        </a>
    </li>
</ul>

<!-- Bảng Danh Sách Khung Giờ -->
<div class="admin-card">
    @if (!Model.Items.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-clock text-muted fs-1 mb-2"></i>
            <h6 class="fw-bold text-dark">Chưa có khung giờ nào được thiết lập</h6>
            <p class="text-muted small mb-0">Nhấn nút <strong>Thêm Khung Giờ Mới</strong> để tạo ca thi đấu đầu tiên.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table align-middle">
                <thead>
                    <tr>
                        <th style="width: 70px;">MÃ CA</th>
                        <th>GIỜ BẮT ĐẦU</th>
                        <th>GIỜ KẾT THÚC</th>
                        <th>HIỂN THỊ CA THI ĐẤU</th>
                        <th class="text-center">ĐƠN ĐÃ PHÁT SINH</th>
                        <th class="text-center">QUYỀN XÓA</th>
                        <th class="text-end" style="width: 150px;">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slot in Model.Items)
                    {
                        <tr>
                            <td>
                                <span class="fw-bold text-muted">#@slot.Id</span>
                            </td>
                            <td>
                                <span class="fw-bold text-dark fs-6">
                                    <i class="bi bi-sunrise text-warning me-1"></i>@slot.GioBatDau.ToString("HH:mm")
                                </span>
                            </td>
                            <td>
                                <span class="fw-bold text-dark fs-6">
                                    <i class="bi bi-sunset text-danger me-1"></i>@slot.GioKetThuc.ToString("HH:mm")
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-light text-navy border fw-bold px-3 py-2 fs-6">
                                    <i class="bi bi-clock me-1 text-primary"></i>@slot.KhungGioDisplay
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border fw-bold px-3 py-1">
                                    @slot.TongDonDat đơn
                                </span>
                            </td>
                            <td class="text-center">
                                @if (slot.CoTheXoa)
                                {
                                    <span class="badge bg-success-subtle text-success">
                                        <i class="bi bi-check-circle me-1"></i>Có thể xóa
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-muted" title="Đã có đơn đặt, hệ thống sẽ chặn xóa cứng">
                                        <i class="bi bi-shield-lock me-1"></i>Khóa xóa cứng
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <!-- Nút Sửa kích hoạt Modal -->
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1"
                                            data-bs-toggle="modal" data-bs-target="#modalEditSlot_@slot.Id" title="Chỉnh sửa ca">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    <!-- Nút Xóa -->
                                    <form asp-area="Admin" asp-controller="KhungGio" asp-action="Delete" method="post" class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa khung giờ [@slot.KhungGioDisplay]?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@slot.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1" title="Xóa khung giờ">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>

                                <!-- Modal Sửa Khung Giờ -->
                                <div class="modal fade" id="modalEditSlot_@slot.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered text-start">
                                        <div class="modal-content rounded-4 border-0 shadow">
                                            <form asp-area="Admin" asp-controller="KhungGio" asp-action="Edit" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@slot.Id" />

                                                <div class="modal-header border-bottom-0 pb-0">
                                                    <h5 class="modal-title fw-bold text-navy" style="color: #002B5B;">
                                                        <i class="bi bi-pencil-square me-2 text-warning"></i>Chỉnh Sửa Ca #@slot.Id
                                                    </h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                                                </div>

                                                <div class="modal-body py-3">
                                                    <div class="row g-3">
                                                        <div class="col-6">
                                                            <label class="form-label fw-semibold small">Giờ Bắt Đầu <span class="text-danger">*</span></label>
                                                            <input type="time" name="gioBatDau" class="form-control rounded-3"
                                                                   value="@slot.GioBatDau.ToString("HH:mm")" required />
                                                        </div>
                                                        <div class="col-6">
                                                            <label class="form-label fw-semibold small">Giờ Kết Thúc <span class="text-danger">*</span></label>
                                                            <input type="time" name="gioKetThuc" class="form-control rounded-3"
                                                                   value="@slot.GioKetThuc.ToString("HH:mm")" required />
                                                        </div>
                                                    </div>
                                                    <div class="alert alert-warning small rounded-3 mt-3 mb-0">
                                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                                        Hệ thống sẽ kiểm tra tự động để đảm bảo ca này không bị chồng chéo với bất kỳ ca nào khác.
                                                    </div>
                                                </div>

                                                <div class="modal-footer border-top-0 pt-0">
                                                    <button type="button" class="btn btn-sm btn-light rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                                                    <button type="submit" class="btn btn-sm btn-primary rounded-pill px-4 fw-semibold" style="background-color: #002B5B; border-color: #002B5B;">
                                                        <i class="bi bi-check-lg me-1 text-warning"></i> Cập Nhật
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal Thêm Khung Giờ Mới -->
<div class="modal fade" id="modalCreateSlot" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered text-start">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-area="Admin" asp-controller="KhungGio" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-navy" style="color: #002B5B;">
                        <i class="bi bi-clock-fill me-2 text-warning"></i>Thêm Khung Giờ Ca Thi Đấu Mới
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>

                <div class="modal-body py-3">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Giờ Bắt Đầu <span class="text-danger">*</span></label>
                            <input type="time" name="gioBatDau" class="form-control rounded-3" value="19:00" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Giờ Kết Thúc <span class="text-danger">*</span></label>
                            <input type="time" name="gioKetThuc" class="form-control rounded-3" value="20:30" required />
                        </div>
                    </div>

                    <div class="alert alert-info small rounded-3 mt-3 mb-0">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        <strong>Ràng buộc chống xung đột:</strong> Hệ thống sẽ từ chối tạo mới nếu giờ đề xuất bị giao hoặc đè lên khung giờ đã có.
                    </div>
                </div>

                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-sm btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-sm btn-primary rounded-pill px-4 fw-semibold" style="background-color: #002B5B; border-color: #002B5B;">
                        <i class="bi bi-plus-lg me-1 text-warning"></i> Khởi Tạo Khung Giờ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

