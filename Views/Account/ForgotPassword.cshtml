@model QLSanBong.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu - Hệ Thống Đặt Sân UTC STADIUM";
    ViewData["HideFooter"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/client/auth.css" asp-append-version="true" />
}

<section class="auth-page-section">
    <div class="container">
        <div class="auth-split-card">
            <div class="row g-0">
                <!-- ===========================================================
                     CỘT TRÁI (NỀN XANH NAVY #002B5B + LOGO + HƯỚNG DẪN KHÔI PHỤC)
                =========================================================== -->
                <div class="col-lg-5 auth-brand-pane">
                    <div class="auth-brand-top">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <img src="~/uploads/sanbong/logo.png"
                                 alt="Logo UTC STADIUM"
                                 class="auth-brand-logo"
                                 onerror="this.onerror=null;this.src='data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2280%22 height=%2280%22><rect width=%22100%25%22 height=%22100%25%22 rx=%2216%22 fill=%22%23FFC107%22/><text x=%2250%25%22 y=%2255%25%22 font-family=%22sans-serif%22 font-weight=%22bold%22 font-size=%2222%22 fill=%22%23002B5B%22 text-anchor=%22middle%22 dominant-baseline=%22middle%22>UTC</text></svg>';" />
                            <div>
                                <div class="auth-brand-title">UTC STADIUM</div>
                                <div class="auth-brand-subtitle">SÂN BÓNG SINH VIÊN</div>
                            </div>
                        </div>

                        <div class="auth-slogan-badge">
                            <i class="bi bi-shield-lock-fill text-warning me-1"></i>
                            <span>Bảo mật tài khoản qua Gmail OTP</span>
                        </div>

                        <h2 class="auth-pane-heading">
                            Khôi Phục Mật Khẩu Nhanh Chóng &amp; An Toàn
                        </h2>

                        <p class="auth-pane-desc">
                            Chỉ cần nhập địa chỉ Email đã đăng ký tại UTC STADIUM. Hệ thống sẽ gửi ngay mã xác thực OTP gồm 6 chữ số tới hộp thư của bạn.
                        </p>
                    </div>

                    <div class="auth-feature-list mt-3">
                        <div class="auth-feature-item">
                            <span class="auth-feature-icon"><i class="bi bi-envelope-check-fill"></i></span>
                            <div>
                                <div class="fw-bold text-white small">Bước 1: Nhập Email tài khoản</div>
                                <div class="text-white-50" style="font-size: 0.77rem;">Hệ thống kiểm tra Email trong cơ sở dữ liệu thành viên</div>
                            </div>
                        </div>
                        <div class="auth-feature-item mb-0">
                            <span class="auth-feature-icon"><i class="bi bi-key-fill"></i></span>
                            <div>
                                <div class="fw-bold text-white small">Bước 2: Nhập mã OTP &amp; Đặt mật khẩu mới</div>
                                <div class="text-white-50" style="font-size: 0.77rem;">Mã xác thực 6 chữ số có hiệu lực bảo mật trong 5 phút</div>
                            </div>
                        </div>
                    </div>

                    <div class="auth-brand-footer mt-auto pt-3">
                        <a asp-area="" asp-controller="Account" asp-action="Login" class="auth-back-home">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại trang Đăng nhập
                        </a>
                    </div>
                </div>

                <!-- ===========================================================
                     CỘT PHẢI (NỀN TRẮNG - FORM NHẬP EMAIL NHẬN MÃ OTP)
                =========================================================== -->
                <div class="col-lg-7 auth-form-pane">
                    <div class="auth-form-inner">
                        <div class="mb-3">
                            <span class="auth-step-pill">Khôi Phục Tài Khoản (Bước 1/2)</span>
                            <h1 class="auth-form-title">Quên Mật Khẩu?</h1>
                            <p class="auth-form-subtitle mb-0">
                                Nhập địa chỉ Email liên kết với tài khoản <strong>UTC STADIUM</strong> của bạn để nhận mã OTP gồm 6 chữ số.
                            </p>
                        </div>

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert auth-alert-success d-flex align-items-center gap-2 mb-3 py-2" role="alert">
                                <i class="bi bi-check-circle-fill fs-5"></i>
                                <div>@TempData["SuccessMessage"]</div>
                            </div>
                        }

                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                        {
                            <div class="alert auth-alert-error d-flex align-items-start gap-2 mb-3 py-2" role="alert">
                                <i class="bi bi-exclamation-octagon-fill fs-5 mt-1"></i>
                                <div asp-validation-summary="ModelOnly" class="mb-0"></div>
                            </div>
                        }

                        <form asp-area="" asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
                            @Html.AntiForgeryToken()

                            <!-- Ô nhập Email đã đăng ký -->
                            <div class="mb-4">
                                <label asp-for="Email" class="auth-label">Địa chỉ Email đã đăng ký <span class="text-danger">*</span></label>
                                <div class="auth-input-group">
                                    <span class="auth-input-icon"><i class="bi bi-envelope-at-fill"></i></span>
                                    <input asp-for="Email"
                                           class="form-control auth-input"
                                           placeholder="Ví dụ: sinhvien@st.utc.edu.vn hoặc email cá nhân"
                                           autocomplete="email" />
                                </div>
                                <span asp-validation-for="Email" class="auth-error-msg"></span>
                            </div>

                            <!-- Nút Submit gửi mã OTP -->
                            <button type="submit" class="btn auth-btn-submit w-100">
                                <i class="bi bi-send-check-fill fs-5"></i>
                                <span>Gửi Mã Xác Thực OTP Qua Email</span>
                            </button>
                        </form>

                        <!-- Đã có mã OTP hoặc nhớ lại mật khẩu -->
                        <div class="d-flex flex-wrap align-items-center justify-content-between auth-switch-box mt-4 pt-3 border-top gap-2">
                            <div>
                                <span class="text-muted">Đã nhớ mật khẩu?</span>
                                <a asp-area="" asp-controller="Account" asp-action="Login" class="auth-switch-link ms-1">
                                    Đăng nhập ngay <i class="bi bi-arrow-right-short"></i>
                                </a>
                            </div>
                            <a asp-area="" asp-controller="Account" asp-action="ResetPassword" class="auth-forgot-link">
                                <i class="bi bi-shield-check"></i> Đã có mã OTP? Đặt lại mật khẩu
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Dòng bản quyền nhỏ gọn dưới đáy -->
        <div class="auth-mini-copyright text-center mt-3">
            &copy; 2026 <strong>UTC STADIUM</strong> &bull; Hệ Thống Đặt Sân &amp; Kết Nối Giải Đấu Sinh Viên
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

