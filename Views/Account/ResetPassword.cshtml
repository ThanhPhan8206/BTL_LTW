@model QLSanBong.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu mới - Hệ Thống Đặt Sân UTC STADIUM";
    ViewData["HideFooter"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/client/auth.css" asp-append-version="true" />
}

<section class="auth-page-section">
    <div class="container">
        <div class="auth-split-card">
            <div class="row g-0">
                <!-- ===========================================================
                     CỘT TRÁI (NỀN XANH NAVY #002B5B + LOGO + LƯU Ý BẢO MẬT)
                =========================================================== -->
                <div class="col-lg-5 auth-brand-pane">
                    <div class="auth-brand-top">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <img src="~/uploads/sanbong/logo.png"
                                 alt="Logo UTC STADIUM"
                                 class="auth-brand-logo"
                                 onerror="this.onerror=null;this.src='data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2280%22 height=%2280%22><rect width=%22100%25%22 height=%22100%25%22 rx=%2216%22 fill=%22%23FFC107%22/><text x=%2250%25%22 y=%2255%25%22 font-family=%22sans-serif%22 font-weight=%22bold%22 font-size=%2222%22 fill=%22%23002B5B%22 text-anchor=%22middle%22 dominant-baseline=%22middle%22>UTC</text></svg>';" />
                            <div>
                                <div class="auth-brand-title">UTC STADIUM</div>
                                <div class="auth-brand-subtitle">SÂN BÓNG SINH VIÊN</div>
                            </div>
                        </div>

                        <div class="auth-slogan-badge">
                            <i class="bi bi-patch-check-fill text-warning me-1"></i>
                            <span>Xác thực OTP &amp; Cập nhật mật khẩu</span>
                        </div>

                        <h2 class="auth-pane-heading">
                            Thiết Lập Mật Khẩu Mới Cho Tài Khoản Của Bạn
                        </h2>

                        <p class="auth-pane-desc">
                            Kiểm tra hộp thư đến (hoặc mục Spam/Quảng cáo) của Gmail để lấy mã OTP gồm 6 chữ số và hoàn tất cập nhật mật khẩu mới.
                        </p>
                    </div>

                    <div class="auth-feature-list mt-3">
                        <div class="auth-feature-item">
                            <span class="auth-feature-icon"><i class="bi bi-clock-history"></i></span>
                            <div>
                                <div class="fw-bold text-white small">Hiệu lực OTP trong 5 phút</div>
                                <div class="text-white-50" style="font-size: 0.77rem;">Mã xác thực tự động hủy ngay sau khi đổi mật khẩu thành công</div>
                            </div>
                        </div>
                        <div class="auth-feature-item mb-0">
                            <span class="auth-feature-icon"><i class="bi bi-shield-lock-fill"></i></span>
                            <div>
                                <div class="fw-bold text-white small">Mã hóa mật khẩu chuẩn Identity</div>
                                <div class="text-white-50" style="font-size: 0.77rem;">Mật khẩu mới được băm một chiều an toàn vào cơ sở dữ liệu</div>
                            </div>
                        </div>
                    </div>

                    <div class="auth-brand-footer mt-auto pt-3">
                        <a asp-area="" asp-controller="Account" asp-action="ForgotPassword" asp-route-email="@Model.Email" class="auth-back-home">
                            <i class="bi bi-arrow-repeat me-1"></i> Chưa nhận được mã? Gửi lại OTP
                        </a>
                    </div>
                </div>

                <!-- ===========================================================
                     CỘT PHẢI (NỀN TRẮNG - FORM NHẬP OTP & MẬT KHẨU MỚI)
                =========================================================== -->
                <div class="col-lg-7 auth-form-pane">
                    <div class="auth-form-inner">
                        <div class="mb-3">
                            <span class="auth-step-pill">Khôi Phục Tài Khoản (Bước 2/2)</span>
                            <h1 class="auth-form-title">Đặt Lại Mật Khẩu Mới</h1>
                            <p class="auth-form-subtitle mb-0">
                                Nhập mã OTP 6 chữ số đã gửi qua Gmail và thiết lập mật khẩu mới cho tài khoản của bạn.
                            </p>
                        </div>

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert auth-alert-success d-flex align-items-center gap-2 mb-3 py-2" role="alert">
                                <i class="bi bi-envelope-check-fill fs-5"></i>
                                <div>@TempData["SuccessMessage"]</div>
                            </div>
                        }

                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                        {
                            <div class="alert auth-alert-error d-flex align-items-start gap-2 mb-3 py-2" role="alert">
                                <i class="bi bi-exclamation-octagon-fill fs-5 mt-1"></i>
                                <div asp-validation-summary="ModelOnly" class="mb-0"></div>
                            </div>
                        }

                        <form asp-area="" asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
                            @Html.AntiForgeryToken()

                            <div class="row g-2 mb-2">
                                <!-- Ô Email tài khoản -->
                                <div class="col-md-7">
                                    <label asp-for="Email" class="auth-label">Email tài khoản <span class="text-danger">*</span></label>
                                    <div class="auth-input-group">
                                        <span class="auth-input-icon"><i class="bi bi-envelope-at-fill"></i></span>
                                        <input asp-for="Email"
                                               class="form-control auth-input"
                                               placeholder="Nhập email đã nhận OTP"
                                               autocomplete="email" />
                                    </div>
                                    <span asp-validation-for="Email" class="auth-error-msg"></span>
                                </div>

                                <!-- Ô Mã xác thực OTP 6 số -->
                                <div class="col-md-5">
                                    <label asp-for="MaOtp" class="auth-label">Mã OTP (6 chữ số) <span class="text-danger">*</span></label>
                                    <div class="auth-input-group">
                                        <span class="auth-input-icon"><i class="bi bi-shield-check"></i></span>
                                        <input asp-for="MaOtp"
                                               class="form-control auth-input auth-otp-input"
                                               maxlength="6"
                                               inputmode="numeric"
                                               placeholder="123456"
                                               autocomplete="one-time-code" />
                                    </div>
                                    <span asp-validation-for="MaOtp" class="auth-error-msg"></span>
                                </div>
                            </div>

                            <!-- Hàng 2 cột: Mật khẩu mới & Xác nhận mật khẩu mới -->
                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="MatKhauMoi" class="auth-label">Mật khẩu mới <span class="text-danger">*</span></label>
                                    <div class="auth-input-group">
                                        <span class="auth-input-icon"><i class="bi bi-lock-fill"></i></span>
                                        <input asp-for="MatKhauMoi"
                                               id="newPasswordInput"
                                               class="form-control auth-input pe-5"
                                               placeholder="Tối thiểu 6 ký tự"
                                               autocomplete="new-password" />
                                        <button type="button"
                                                class="auth-toggle-password"
                                                data-target="newPasswordInput"
                                                aria-label="Ẩn/Hiện mật khẩu mới">
                                            <i class="bi bi-eye-slash"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="MatKhauMoi" class="auth-error-msg"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="XacNhanMatKhauMoi" class="auth-label">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                                    <div class="auth-input-group">
                                        <span class="auth-input-icon"><i class="bi bi-shield-lock-fill"></i></span>
                                        <input asp-for="XacNhanMatKhauMoi"
                                               id="confirmNewPasswordInput"
                                               class="form-control auth-input pe-5"
                                               placeholder="Nhập lại mật khẩu mới"
                                               autocomplete="new-password" />
                                        <button type="button"
                                                class="auth-toggle-password"
                                                data-target="confirmNewPasswordInput"
                                                aria-label="Ẩn/Hiện xác nhận mật khẩu mới">
                                            <i class="bi bi-eye-slash"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="XacNhanMatKhauMoi" class="auth-error-msg"></span>
                                </div>
                            </div>

                            <!-- Nút Submit Xác nhận đổi mật khẩu -->
                            <button type="submit" class="btn auth-btn-submit w-100">
                                <i class="bi bi-check2-circle fs-5"></i>
                                <span>Xác Nhận Đặt Lại Mật Khẩu</span>
                            </button>
                        </form>

                        <!-- Chuyển đổi về Đăng nhập hoặc Gửi lại OTP -->
                        <div class="d-flex flex-wrap align-items-center justify-content-between auth-switch-box mt-3 pt-3 border-top gap-2">
                            <a asp-area="" asp-controller="Account" asp-action="ForgotPassword" asp-route-email="@Model.Email" class="auth-forgot-link">
                                <i class="bi bi-arrow-clockwise"></i> Gửi lại mã OTP mới
                            </a>
                            <a asp-area="" asp-controller="Account" asp-action="Login" class="auth-switch-link">
                                Quay về Đăng nhập <i class="bi bi-arrow-right-short"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Dòng bản quyền nhỏ gọn dưới đáy -->
        <div class="auth-mini-copyright text-center mt-3">
            &copy; 2026 <strong>UTC STADIUM</strong> &bull; Hệ Thống Đặt Sân &amp; Kết Nối Giải Đấu Sinh Viên
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".auth-toggle-password").forEach(btn => {
                btn.addEventListener("click", function () {
                    const targetId = this.getAttribute("data-target");
                    const input = document.getElementById(targetId);
                    const icon = this.querySelector("i");
                    if (!input) return;

                    if (input.type === "password") {
                        input.type = "text";
                        icon.classList.remove("bi-eye-slash");
                        icon.classList.add("bi-eye");
                    } else {
                        input.type = "password";
                        icon.classList.remove("bi-eye");
                        icon.classList.add("bi-eye-slash");
                    }
                });
            });
        });
    </script>
}

