<!-- ===================================================================
     HIỆU ỨNG 4: LIGHTBOX MODAL XEM ẢNH PHÓNG TO GÓC ẢNH THANH XUÂN
=================================================================== -->
<div class="modal fade" id="youthLightboxModal" tabindex="-1" aria-labelledby="youthLightboxModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content lightbox-modal-content">
            <div class="modal-header border-0 pb-2">
                <span id="lightboxClassTag" class="badge bg-warning text-dark fw-bold px-3 py-2 rounded-pill">K64 - CNTT1</span>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-3 pt-1">
                <div class="lightbox-img-wrapper">
                    <img id="lightboxImage" src="" alt="Ảnh phóng to tập thể lớp" class="lightbox-full-img" onerror="@fallbackSvg" />
                </div>
                <div class="pt-3 px-1">
                    <h5 id="lightboxTitle" class="fw-bold text-white mb-1"></h5>
                    <p id="lightboxDesc" class="text-white-50 mb-0 small"></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Hiệu ứng đếm số tăng dần (Count-Up Animation) cho Thanh thống kê
            const counters = document.querySelectorAll(".counter-number");
            const duration = 1500;

            counters.forEach(counter => {
                const target = parseInt(counter.getAttribute("data-target"), 10) || 0;
                const pad = parseInt(counter.getAttribute("data-pad"), 10) || 0;
                const suffix = counter.getAttribute("data-suffix") || "";
                const startTime = performance.now();

                function updateCount(currentTime) {
                    const elapsed = currentTime - startTime;
                    const progress = Math.min(elapsed / duration, 1);
                    const easeOut = 1 - Math.pow(1 - progress, 3);
                    const currentVal = Math.floor(easeOut * target);

                    let formatted = currentVal.toString();
                    if (pad > 0) {
                        formatted = formatted.padStart(pad, "0");
                    }
                    counter.textContent = formatted + suffix;

                    if (progress < 1) {
                        requestAnimationFrame(updateCount);
                    } else {
                        let finalFormatted = target.toString();
                        if (pad > 0) {
                            finalFormatted = finalFormatted.padStart(pad, "0");
                        }
                        counter.textContent = finalFormatted + suffix;
                    }
                }

                setTimeout(() => requestAnimationFrame(updateCount), 350);
            });

            // 2. Hiệu ứng Scroll Reveal khi cuộn trang xuống các khối bên dưới
            const revealElements = document.querySelectorAll(".reveal-on-scroll");
            if ("IntersectionObserver" in window) {
                const observer = new IntersectionObserver((entries, obs) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("is-visible");
                            obs.unobserve(entry.target);
                        }
                    });
                }, {
                    threshold: 0.12,
                    rootMargin: "0px 0px -40px 0px"
                });

                revealElements.forEach(el => observer.observe(el));
            } else {
                revealElements.forEach(el => el.classList.add("is-visible"));
            }

            // 3. Hiệu ứng Chọn nhanh ca trống trong Card sân bóng
            const pitchCards = document.querySelectorAll(".pitch-card");
            pitchCards.forEach(card => {
                const slotBtns = card.querySelectorAll(".slot-pill");
                const bookBtnText = card.querySelector(".btn-book-text");

                slotBtns.forEach(btn => {
                    btn.addEventListener("click", function () {
                        const selectedSlot = this.getAttribute("data-slot");
                        const wasActive = this.classList.contains("active");

                        // Bỏ trạng thái active của các ca khác trong cùng 1 card sân
                        slotBtns.forEach(b => b.classList.remove("active"));

                        if (!wasActive) {
                            this.classList.add("active");
                            if (bookBtnText) {
                                bookBtnText.textContent = "Đặt ngay ca " + selectedSlot;
                            }
                        } else {
                            if (bookBtnText) {
                                bookBtnText.textContent = "Đặt sân ngay";
                            }
                        }
                    });
                });
            });

            // 4. Hiệu ứng Xem ảnh phóng to - Lightbox Modal cho Góc ảnh thanh xuân
            const lightboxModalEl = document.getElementById("youthLightboxModal");
            if (lightboxModalEl && typeof bootstrap !== "undefined") {
                const lightboxModal = new bootstrap.Modal(lightboxModalEl);
                const modalImg = document.getElementById("lightboxImage");
                const modalTag = document.getElementById("lightboxClassTag");
                const modalTitle = document.getElementById("lightboxTitle");
                const modalDesc = document.getElementById("lightboxDesc");

                document.querySelectorAll(".youth-lightbox-trigger").forEach(card => {
                    card.addEventListener("click", function () {
                        const imgSrc = this.getAttribute("data-img");
                        const tag = this.getAttribute("data-tag");
                        const title = this.getAttribute("data-title");
                        const desc = this.getAttribute("data-desc");

                        if (modalImg) modalImg.src = imgSrc;
                        if (modalTag) modalTag.textContent = tag;
                        if (modalTitle) modalTitle.textContent = title;
                        if (modalDesc) modalDesc.textContent = desc;

                        lightboxModal.show();
                    });
                });
            }
        });
    </script>
}
